# macOS
.DS_Store

# Banco ChromaDB local
backend/data/chroma/

# Uploads de audio gerados em execucao.
# Os dois arquivos de teste ja versionados (audio.wav e teste.ogg) continuam
# no repositorio de proposito; esta regra evita que novas gravacoes feitas
# durante os testes entrem sem querer.
backend/uploads/

# IDEs
.vscode/
.idea/

# Claude Code: sessao e configuracao local ficam fora; so os atalhos dos
# agentes de construcao entram (agentes/README.md).
.claude/*
!.claude/agents/

# Bancos vetoriais e backups locais
backend/data/chroma/
backend/data/chroma_backup*/

# Rodadas de avaliacao. Toda rodada grava em runs/; entram no repositorio
# apenas as promovidas para cited/, que sustentam um numero escrito em
# alguma evidencia.
data/evaluation/runs/

# Rodadas da regua de recuperacao. Mesma regra: entram no repositorio
# apenas as citadas, promovidas para data/retrieval/cited/.
data/retrieval/runs/

