# .env do servidor de produção. Copie para a raiz do repositório no servidor:
#   cp deploy/env.prod.example .env   e preencha o que está vazio.
# Nunca versione este arquivo preenchido (o .gitignore já cobre .env).

# Nomes que o Caddy vai certificar, separados por vírgula (o primeiro é o
# principal). No Azure: ROTULO.REGIAO.cloudapp.azure.com (rótulo DNS do IP
# fixo); sem nada: IP.sslip.io. Ex. do servidor atual:
#   DOMAIN=vetia.chilecentral.cloudapp.azure.com, 57.156.57.72.sslip.io
DOMAIN=

# A POC completa, como em docs/poc-utilizavel.md: contas próprias no Mongo
# (sem Supabase) e os acessos rápidos "Entrar como tutor/clínica". Os acessos
# rápidos são contas COMPARTILHADAS: quem entra por eles vê o que os outros
# fizeram por eles. Para só contas próprias: POC_QUICK_LOGIN_ENABLED=false
# (some também a clínica fictícia que recebe encaminhamentos).
WORKFLOW_MODE=poc
AUTH_PROVIDER=local
POC_QUICK_LOGIN_ENABLED=true
SESSION_TTL_HOURS=24
# Origens permitidas no CORS: https:// + cada nome do DOMAIN, por vírgula.
FRONTEND_ORIGINS=https://SEU_DOMINIO_AQUI

# Atendente: Gemini, sem troca silenciosa (decisão da rodada 18 do João).
# Sem GPU no servidor, o Ollama não sobe; escolher "modelo local" na tela faz
# a análise falhar com aviso genérico, relato salvo (B-81).
ATTENDANT_PROVIDER=gemini
ATTENDANT_FALLBACK=none
GEMINI_API_KEY=
# Chaves de reserva, separadas por vírgula: quando a cota do dia de uma
# acaba, o atendente passa para a próxima (mesmo modelo).
GEMINI_API_KEYS=
# Espaçamento mínimo entre chamadas ao Gemini. 4 s é o valor do runner (uma
# rodada inteira sem esbarrar no limite por minuto); com várias pessoas usando
# ao mesmo tempo, 2 s equilibra limite e fila. A cota gratuita é de 500
# chamadas por dia para todos os visitantes somados.
GEMINI_MIN_INTERVAL_S=2

# Clínicas: google = Places/Geocoding/Routes reais. A Demo Key do Google
# (gratuita, sem cartão; developers.google.com/maps/demo-key) serve nas duas
# linhas, com MAPS_KEY_KIND=demo (não pede avaliações e fotos). Chave com
# billing: MAPS_KEY_KIND=standard, a de servidor restrita ao IP da VM e a web ao
# DOMAIN. Sem chave: MAPS_PROVIDER=fixtures (só as clínicas fictícias).
MAPS_PROVIDER=google
MAPS_KEY_KIND=demo
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_WEB_KEY=

# Busca e prompt: os padrões medidos (não mude sem rodada medida).
RETRIEVAL_MODE=vector
CONTEXT_TOP_K=3
CONTEXT_MIN_SCORE=0.0
WORKSPACE_PROMPT_VERSION=v1_grounded

DEBUG=false
ENVIRONMENT=production
MONGODB_DB_NAME=vetai
