# Copie este arquivo para .env na raiz do projeto e ajuste o que precisar:
#
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
#
# O .env nao entra no Git. Todos os valores abaixo tem um padrao razoavel
# no codigo (backend/app/core/config.py); o arquivo serve para documentar
# o que existe e para sobrescrever por maquina.

# ==========================
# Ollama (LLM local)
# ==========================
# Rodando pelo docker compose, o backend fala com o container "ollama".
# O proprio compose ja injeta esse valor; use a linha abaixo apenas se
# for rodar o backend fora do Docker, apontando para o Ollama da maquina.
OLLAMA_HOST=http://localhost:11434

LLM_MODEL=llama3.2:3b

# ==========================
# Ambiente
# ==========================
DEBUG=True
ENVIRONMENT=development
