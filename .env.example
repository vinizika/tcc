# Copie este arquivo para .env na raiz do projeto e ajuste o que precisar:
#
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
#
# O .env nao entra no Git. Todos os valores abaixo tem um padrao razoavel no
# codigo (backend/app/core/config.py); o arquivo serve para documentar o que
# existe e para sobrescrever por maquina. O mesmo .env atende o docker compose
# e o backend rodando fora do container.

# ==========================
# Ollama (LLM local)
# ==========================
# Rodando pelo docker compose, o backend fala com o container "ollama" e o
# proprio compose ja injeta esse valor. Use a linha abaixo apenas se for rodar
# o backend fora do Docker, apontando para o Ollama da maquina.
OLLAMA_HOST=http://localhost:11434

# O modelo local. Desde 25/09 e o qwen3:8b (baixe com: ollama pull qwen3:8b);
# o llama3.2:3b, o atendente ate 24/09, continua pelo preset local_llama.
# O qwen precisa de GPU (sem ela, ~34 s por caso).
LLM_MODEL=qwen3:8b

# O qwen3 "pensa" antes de responder se a chamada nao disser que nao; a
# arquitetura foi medida sem pensar. Vazio = nao mandar o parametro.
LLM_THINK=False

# Temperatura zero e seed fixa mantem as rodadas de avaliacao reproduziveis.
LLM_TEMPERATURE=0.0
LLM_SEED=42

# Tamanho do contexto e da resposta. O Ollama trunca o prompt em silencio
# quando ele passa de LLM_NUM_CTX, entao o valor fica explicito.
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=600

LLM_TIMEOUT_S=600
LLM_KEEP_ALIVE=10m

# schema = restringe a decodificacao ao formato esperado (recomendado)
# json   = garante apenas que a saida e um JSON valido
STRUCTURED_OUTPUT_MODE=schema

# ==========================
# Atendente (quem classifica a urgencia)
# ==========================
# gemini = o padrao desde 25/09 (decisao de produto do Joao); ollama = o
# modelo local (LLM_MODEL). O sistema nunca troca de modelo em silencio: com
# ATTENDANT_FALLBACK=none, se o atendente falhar (sem chave, sem cota, sem
# rede) a API responde 503 dizendo qual e por que; com ATTENDANT_FALLBACK=
# ollama, responde pelo modelo local e avisa na resposta.
ATTENDANT_PROVIDER=gemini
ATTENDANT_FALLBACK=none

# ==========================
# Gemini
# ==========================
# NUNCA coloque uma chave de verdade neste arquivo (.env.example e
# versionado). Cole sua chave real no seu .env local, que fica de fora do
# Git. Sem chave e com ATTENDANT_PROVIDER=gemini, o /chat/ responde 503
# (attendant_unavailable). A cota gratuita do flash-lite e de 500 chamadas
# por dia e por conta.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=60
# Espaco minimo entre chamadas (a cota gratuita tem limite por minuto).
GEMINI_MIN_INTERVAL_S=4

# ==========================
# Pipeline: etapas ligadas/desligadas
# ==========================
# Usadas no estudo de ablacao. Com RETRIEVAL_ENABLED=False o sistema roda como
# LLM puro, que e a linha de base contra a qual o RAG e medido.
#
# O "tradutor" (reescrita, multi-query e HyDE) fica desligado por padrao desde
# 25/09: nas fichas de triagem, toda tecnica piora a busca (rodada 17 do
# Joao). Os presets fichas_tradutor e hoje_academico_llama_tradutor religam.
QUERY_REWRITING_ENABLED=False
MULTI_QUERY_ENABLED=False
HYDE_ENABLED=False
RETRIEVAL_ENABLED=True
COT_ENABLED=False
SELF_REFINE_ENABLED=False

# vector = busca vetorial pura nas fichas (padrao); routed_rerank = o caminho
# ate 24/09 (rota lexical, reranker, ancoras, veto de especie).
RETRIEVAL_MODE=vector

# Quantas fichas vao no prompt da classificacao, e a nota minima. Com as
# fichas, entram sempre as 3 mais proximas (0.0). A porta de 0.72 e da base
# academica (preset hoje_academico_llama).
CONTEXT_TOP_K=3
CONTEXT_MIN_SCORE=0.0

TRIAGE_PROMPT_VERSION=v1_grounded

# ==========================
# Upload de voz (POST /voice/)
# ==========================
# Teto do audio aceito na transcricao, em MB.
MAX_AUDIO_UPLOAD_MB=25

# ==========================
# Persistencia: tutores, pets e historico de conversa
# ==========================
# Supabase (Postgres) guarda tutores e pets. Vazio = rotas /tutors e /pets
# devolvem 503; o resto do sistema funciona normalmente. Crie um projeto em
# supabase.com e rode backend/supabase_schema.sql no SQL Editor dele.
SUPABASE_URL=
SUPABASE_KEY=

# MongoDB guarda o historico de conversa. O docker compose ja sobe um
# container local (servico "mongo") e injeta o endereco dele; o padrao
# abaixo so importa rodando o backend fora do Docker.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=vetai

# ==========================
# Segunda etapa: encaminhamento tutor-clínica
# ==========================
# demo = contas e clínicas inequivocamente fictícias, sem Google/Supabase.
# poc = contas próprias e acessos acadêmicos independentes de Maps.
# real = modo sem fallback para demo. O provedor de identidade é explícito.
WORKFLOW_MODE=demo
AUTH_PROVIDER=supabase
POC_QUICK_LOGIN_ENABLED=false
SESSION_TTL_HOURS=24
# auto acompanha o modo legado; google nunca substitui falhas por fixtures.
MAPS_PROVIDER=auto
# demo: não solicita avaliações/fotos. standard: chave própria com billing.
MAPS_KEY_KIND=demo
# Workspace: coleção experimental específica sem alterar ponteiro da pesquisa.
POC_RAG_PATH=
POC_RAG_COLLECTION=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
WORKFLOW_POLL_INTERVAL_S=8

# Chave de servidor: restrinja a Places API (New), Geocoding v4 e Routes e, quando
# possível, ao IP do backend. Nunca é incluída no bundle do navegador.
GOOGLE_MAPS_SERVER_KEY=

# Chave web: restrinja por domínio e somente à Maps JavaScript API/Places.
# Ela é pública por natureza, mas as restrições evitam uso em outros sites.
GOOGLE_MAPS_WEB_KEY=
GOOGLE_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_LANGUAGE=pt-BR
GOOGLE_MAPS_REGION=BR

# ==========================
# Banco vetorial
# ==========================
# Caminho relativo ao backend quando executado pela aplicação. Desde 25/09 e
# a pasta versionada backend/chroma_db, com o ponteiro da colecao ativa (as
# 61 fichas no bge-m3). Novas ingestões criam coleções versionadas; este nome
# é também a exceção legada.
CHROMA_PATH=chroma_db
CHROMA_COLLECTION=veterinary_documents

# ==========================
# Ambiente
# ==========================
DEBUG=True
ENVIRONMENT=development
