      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Producer>MicrosoftÂ® PowerPointÂ® 2010</pdf:Producer>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Bruchim Yaron</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Fig 5: Median total serum histones concentration at presentation to the hospital in 10 non- survivor, 6 survivors and 7 healthy controls dogs with naturally-occurring heatstroke. Median total serum histones are significantly (P=0.041) increased in all dogs with naturally occurring heatstroke compared to their level in 7 healthy dogs. Median total serum histones in non-survivors was significantly (P=0.049) higher among non-survivors compared to survivors.</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:format>application/postscript</dc:format>
      </rdf:Description>
